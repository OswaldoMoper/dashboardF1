cabal-version:      2.4
name:               frontend
version:            0.1.0.0
synopsis:           F1 Functional Dashboard frontend (Reflex-DOM).
description:
  Frontend reactivo del F1 Functional Dashboard con reflex-frp, compilado con
  el backend JavaScript nativo de GHC (javascript-unknown-ghcjs). En Fase 0
  solo renderiza el skeleton; los widgets llegan en Fase 2.
license:            BSD-3-Clause
author:             Oscar Oswaldo Moya Pérez
maintainer:         oswaldomoyap@gmail.com
build-type:         Simple

executable frontend
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
    hs-source-dirs:   src
    main-is:          Main.hs
    other-modules:
        App
        Client
        Pages.Dashboard
        Widgets.Comparison
        Widgets.Comparison.Helper
        Widgets.Historical
        Widgets.Live
        Widgets.Live.Helper
        Widgets.LiveTiming
        Widgets.LiveTiming.Helper
        Widgets.TyreStrategy
        Widgets.TyreStrategy.Helper
    build-depends:
        base        >= 4.14 && < 5
      , aeson
      , case-insensitive
      , common
      , containers
      , ghcjs-dom
      , jsaddle
      , reflex
      , reflex-dom
      , text
      , time
    ghc-options: -Wall -O

    if arch(javascript)
        ghc-options: -optl-sEXPORTED_RUNTIME_METHODS=HEAP8,HEAPU8

    -- Con GHC nativo no se construye: Reflex no se compila para el PC.
    if !arch(javascript)
        buildable: False

-- Los módulos Helper, sin Reflex, con GHC nativo.
test-suite frontend-test
    type:             exitcode-stdio-1.0
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
    hs-source-dirs:   src test
    main-is:          Spec.hs
    other-modules:
        Widgets.Comparison.Helper
        Widgets.Live.Helper
        Widgets.LiveTiming.Helper
        Widgets.TyreStrategy.Helper
    build-depends:
        base        >= 4.14 && < 5
      , QuickCheck
      , common
      , hspec
      , text
    ghc-options: -Wall
