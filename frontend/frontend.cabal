cabal-version:      2.4
name:               frontend
version:            0.1.0.0
synopsis:           F1 Functional Dashboard frontend (Reflex-DOM).
description:
  Frontend reactivo del F1 Functional Dashboard con reflex-frp, compilado con
  el backend JavaScript nativo de GHC (javascript-unknown-ghcjs). En Fase 0
  solo renderiza el skeleton; los widgets llegan en Fase 2.
author:             Oscar Oswaldo Moya Pérez
maintainer:         oswaldomoyap@gmail.com
build-type:         Simple

executable frontend
    default-language: Haskell2010
    default-extensions:
        OverloadedStrings
    hs-source-dirs:   src
    main-is:          Main.hs
    other-modules:
        App
    build-depends:
        base        >= 4.14 && < 5
      , common
      , reflex
      , reflex-dom
      , text
    ghc-options: -Wall -O

    if arch(javascript)
        ghc-options: -optl-sEXPORTED_RUNTIME_METHODS=HEAP8,HEAPU8
