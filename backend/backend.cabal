cabal-version:      2.4
name:               backend
version:            0.1.0.0
synopsis:           F1 Functional Dashboard backend (Servant + Warp).
description:
  Backend funcional del F1 Functional Dashboard. La lógica vive en la `library`
  (INFRA en la raíz + negocio en `Handler.<Área>`) y el `executable` es solo el
  punto de entrada, de modo que los módulos sean importables desde una suite de
  tests. Expone `GET /home`, la API de widgets `/api/*` y el bundle del frontend
  en el mismo puerto.
author:             Oscar Oswaldo Moya Pérez
maintainer:         oswaldomoyap@gmail.com
build-type:         Simple

common shared
    default-language: Haskell2010
    default-extensions:
        DataKinds
        DeriveGeneric
        OverloadedStrings
        TypeOperators
    ghc-options: -Wall

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Config
        App
        Server
        Html
        Handler.OpenF1.Helper
        Handler.OpenF1.Manager
        Handler.Live
        Handler.Live.Context
        Handler.Live.Helper
        Handler.Live.Manager
        Handler.Historical
        Handler.Historical.Context
        Handler.Historical.Helper
        Handler.Historical.Manager
        Handler.Telemetry
        Handler.Telemetry.Context
        Handler.Telemetry.Helper
        Handler.Telemetry.Manager
        Handler.Comparison
        Handler.TyreStrategy
        Handler.TyreStrategy.Context
        Handler.TyreStrategy.Helper
        Handler.TyreStrategy.Manager
    build-depends:
        base            >= 4.14 && < 5
      , aeson
      , common
      , filepath
      , http-types
      , lucid
      , req
      , servant
      , servant-lucid
      , servant-server
      , stm
      , text
      , wai
      , wai-app-static
      , warp

executable backend
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        base            >= 4.14 && < 5
      , backend
      , warp
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

test-suite backend-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base            >= 4.14 && < 5
      , QuickCheck
      , aeson
      , backend
      , bytestring
      , common
      , hspec
      , text
