cabal-version:      2.4
name:               backend
version:            0.1.0.0
synopsis:           F1 Functional Dashboard backend (Servant + Warp).
description:
  Backend funcional del F1 Functional Dashboard. En Fase 0 expone únicamente
  el endpoint `GET /home`; la API de widgets llega en Fase 1.
author:             Oscar Oswaldo Moya Pérez
maintainer:         oswaldomoyap@gmail.com
build-type:         Simple

executable backend
    default-language: Haskell2010
    default-extensions:
        DataKinds
        DeriveGeneric
        OverloadedStrings
        TypeOperators
    hs-source-dirs:   src
    main-is:          Main.hs
    other-modules:
        Backend.API
    build-depends:
        base            >= 4.14 && < 5
      , aeson
      , common
      , servant
      , servant-server
      , text
      , wai
      , warp
    ghc-options: -Wall
