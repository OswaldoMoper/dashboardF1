cabal-version:      2.4
name:               backend
version:            0.1.0.0
synopsis:           F1 Functional Dashboard backend (Servant + Warp).
description:
  Backend funcional del F1 Functional Dashboard. La lógica vive en la `library`
  (INFRA en la raíz + negocio en `Handler.<Área>`) y el `executable` es solo el
  punto de entrada, de modo que los módulos sean importables desde una suite de
  tests. Expone `GET /home`, la API de widgets `/api/*` y el bundle del frontend
  en el mismo puerto.
author:             Oscar Oswaldo Moya Pérez
maintainer:         oswaldomoyap@gmail.com
build-type:         Simple

common shared
    default-language: Haskell2010
    default-extensions:
        DataKinds
        DeriveGeneric
        OverloadedStrings
        TypeOperators
    ghc-options: -Wall

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Config
        App
        Auto.Context
        Auto.Helper
        Server
        Html
        Outcome
        Provenance
        Handler.FastF1.Helper
        Handler.FastF1.Manager
        Handler.PublicApi.Manager
        Handler.Feed.Helper
        Handler.Feed.Manager
        Handler.OpenF1.Helper
        Handler.OpenF1.Manager
        Handler.Live
        Handler.Live.Context
        Handler.Live.Helper
        Handler.Live.Manager
        Handler.Historical
        Handler.Historical.Context
        Handler.Historical.Helper
        Handler.Historical.Manager
        Handler.Telemetry
        Handler.Telemetry.Context
        Handler.Telemetry.Helper
        Handler.Telemetry.Manager
        Handler.Comparison
        Handler.Comparison.Context
        Handler.Comparison.Helper
        Handler.Comparison.Manager
        Handler.Drivers
        Handler.Drivers.Context
        Handler.Drivers.Helper
        Handler.Drivers.Manager
        Handler.TyreStrategy
        Handler.TyreStrategy.Context
        Handler.TyreStrategy.Helper
        Handler.TyreStrategy.Manager
    build-depends:
        base            >= 4.14 && < 5
      , aeson
      , base64-bytestring
      , bytestring
      , common
      , containers
      , directory
      , filepath
      , http-client
      , http-types
      , lucid
      , mtl
      , network
      , process
      , req
      , retry
      , servant
      , servant-lucid
      , servant-server
      , stm
      , text
      , time
      , wai
      , wai-app-static
      , warp

executable backend
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:
        base            >= 4.14 && < 5
      , backend
      , text
      , time
      , warp
    ghc-options: -threaded -rtsopts -with-rtsopts=-N

executable dashboardF1-auto
    import:           shared
    hs-source-dirs:   auto
    main-is:          Main.hs
    build-depends:
        base            >= 4.14 && < 5
      , backend
      , directory
      , filepath
      , text
      , time
    ghc-options: -threaded

test-suite backend-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        base            >= 4.14 && < 5
      , QuickCheck
      , aeson
      , backend
      , bytestring
      , common
      -- El índice de nombres de gran premio es un Map y se afirma como tal: pasarlo
      -- a lista para compararlo probaría la conversión y no el índice.
      , containers
      , hspec
      , http-client
      -- Para mirar los parámetros que se le construyen a OpenF1: el operador de un
      -- filtro va dentro del nombre, y si se le intercala un `=` la API responde
      -- 404. Es un fallo que no se ve leyendo el código.
      , req
      , servant
      , text
      , time
